<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <GHelperAssembly Condition="'$(GHelperAssembly)' == ''">../../app/bin/x64/Release/net10.0-windows/win-x64/GHelper.dll</GHelperAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GHelper">
      <HintPath>$(GHelperAssembly)</HintPath>
    </Reference>
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="fixtures/*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
